# --- required ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kinderthread?schema=public"
# Public URL of the site (used for SEO, sitemap, Open Graph, WhatsApp links)
SITE_URL="https://www.example.com"
# Long random string used to sign order-confirmation cookies (openssl rand -hex 32)
AUTH_SECRET=""

# --- first administrator (used by `npm run db:seed`) ---------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password"
# Set to "true" to start the store in pre-launch (coming soon) mode
SEED_PRELAUNCH="true"

# --- optional -------------------------------------------------------------------
# Image storage. Leave empty to store uploads on local disk (./uploads, VPS hosting).
# For serverless hosting (e.g. Vercel) use Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""
