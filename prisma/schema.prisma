// Kinder Thread — database schema
// Money is stored as whole Pakistani rupees (Int).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum Gender {
  BOY
  GIRL
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REFUNDED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum SubscriberSource {
  NEWSLETTER
  LAUNCH
  TRYON
  CHECKOUT
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  phone        String?
  passwordHash String
  role         Role           @default(CUSTOMER)
  tags         String[]       @default([])
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  sessions     Session[]
  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  city       String
  line1      String
  line2      String?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  // "category" = shop taxonomy (Baby Boys…), "collection" = merchandising (Seasonal…)
  kind        String     @default("category")
  sortOrder   Int        @default(0)
  isVisible   Boolean    @default(true)
  showInNav   Boolean    @default(true)
  isFeatured  Boolean    @default(false)
  seoTitle    String?
  seoDescription String?
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SizeGuide {
  id        String    @id @default(cuid())
  name      String
  unit      String    @default("cm")
  // [{ size, age, height, chest, waist, length }]
  rows      Json
  notes     String?
  isDefault Boolean   @default(false)
  products  Product[]
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  fabric         String?
  care           String?
  price          Int
  compareAtPrice Int?
  status         ProductStatus    @default(DRAFT)
  gender         Gender           @default(UNISEX)
  isSample       Boolean          @default(false)
  isFeatured     Boolean          @default(false)
  isNewArrival   Boolean          @default(false)
  isBestSeller   Boolean          @default(false)
  sortOrder      Int              @default(0)
  model3dUrl     String?
  seoTitle       String?
  seoDescription String?
  sizeGuideId    String?
  sizeGuide      SizeGuide?       @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  categories     Category[]
  images         ProductImage[]
  colors         ProductColor[]
  variants       ProductVariant[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model ProductImage {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String        @default("")
  sortOrder Int           @default(0)
  colorId   String?
  color     ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model ProductColor {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  sortOrder Int              @default(0)
  images    ProductImage[]
  variants  ProductVariant[]

  @@index([productId])
}

model ProductVariant {
  id         String        @id @default(cuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String        @unique
  size       String
  colorId    String?
  color      ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  price      Int?
  stock      Int           @default(0)
  isActive   Boolean       @default(true)
  orderItems OrderItem[]

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id               String          @id @default(cuid())
  number           String          @unique
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email            String
  phone            String
  customerName     String
  city             String
  address          String
  postalCode       String?
  notes            String?
  status           OrderStatus     @default(PENDING)
  paymentMethod    String
  paymentStatus    PaymentStatus   @default(UNPAID)
  paymentReference String?
  subtotal         Int
  discount         Int             @default(0)
  shippingFee      Int             @default(0)
  total            Int
  couponCode       String?
  courier          String?
  trackingNumber   String?
  trackingUrl      String?
  internalNote     String?
  items            OrderItem[]
  events           OrderEvent[]
  returnRequests   ReturnRequest[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name        String
  sku         String
  size        String
  color       String?
  image       String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus?
  message   String
  isPublic  Boolean      @default(true)
  actor     String?
  createdAt DateTime     @default(now())

  @@index([orderId])
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      ReturnType
  status    ReturnStatus @default(REQUESTED)
  reason    String
  details   String?
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orderId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType
  value       Int        @default(0)
  minSubtotal Int?
  maxUses     Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

model Subscriber {
  id        String           @id @default(cuid())
  email     String
  source    SubscriberSource @default(NEWSLETTER)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@unique([email, source])
}

model Banner {
  id        String   @id @default(cuid())
  eyebrow   String?
  title     String
  subtitle  String?
  image     String?
  ctaLabel  String?
  ctaHref   String?
  tone      String   @default("sage")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  href      String?
  isSample  Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String
  seoDescription String?
  isPublished    Boolean  @default(true)
  showInFooter   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
