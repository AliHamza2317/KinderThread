# Copy this file to .env and fill in the values (never commit .env).

# MongoDB connection string — MongoDB Atlas: Database → Connect → Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kinder-thread?retryWrites=true&w=majority

# Long random string used to sign sign-in tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# How long a sign-in stays valid (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Websites allowed to call the API from the browser (comma separated)
CORS_ORIGINS=http://localhost:3000

# Port for local development (Vercel ignores it)
PORT=4000

# Optional: Vercel Blob token, enables image uploads from the admin panel
BLOB_READ_WRITE_TOKEN=

# Used once by `npm run seed` to create the first admin account
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
